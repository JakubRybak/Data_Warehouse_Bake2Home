config {
  type: "view",
  schema: "silver",
  description: "Cleaned and standardized site coordinates data, including geography points"
}

SELECT
  CAST(Id AS INT64) AS id_coordinates,
  CAST(Latitude AS FLOAT64) AS latitude,
  CAST(Longitude AS FLOAT64) AS longitude,
  
  -- Create a standard BigQuery GEOGRAPHY point for high-performance spatial analysis
  ST_GEOGPOINT(CAST(Longitude AS FLOAT64), CAST(Latitude AS FLOAT64)) AS geo_point,
  
  CAST(Created AS TIMESTAMP) AS created_at,
  CAST(Updated AS TIMESTAMP) AS updated_at,
  CAST(UserId AS STRING) AS user_id,
  CAST(ModifiedByUserId AS STRING) AS modified_by_user_id
FROM ${ref("raw_client_manager_SiteCoordinates")}
