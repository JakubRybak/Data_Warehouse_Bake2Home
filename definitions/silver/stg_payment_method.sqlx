config {
  type: "view",
  schema: "silver",
  description: "Cleaned and standardized payment method data from wallet-db"
}

SELECT
  CAST(Id AS INT64) AS id_payment_method,
  COALESCE(CAST(Type AS INT64), 0) AS type,
  COALESCE(CAST(Currency AS STRING), 'Unknown') AS currency,
  COALESCE(CAST(Status AS INT64), 0) AS state,
  COALESCE(CAST(CardBrand AS STRING), 'Unknown') AS card_brand,
  COALESCE(CAST(Mobile AS BOOL), FALSE) AS mobile,
  CAST(Created AS TIMESTAMP) AS created_at,
  CAST(Updated AS TIMESTAMP) AS updated_at,
  COALESCE(CAST(UserId AS STRING), 'Unknown') AS user_id,
  CAST(CustomerId AS INT64) AS id_customer,
  COALESCE(CAST(MarkedAsPrimaryOnCreation AS BOOL), FALSE) AS marked_as_primary_on_creation
FROM ${ref("raw_wallet_PaymentMethods")}
