config {
  type: "view",
  schema: "silver",
  description: "Cleaned and standardized offer product relationship data from catalog-db"
}

SELECT
  CAST(Id AS INT64) AS id_offer_product,
  CAST(ProductId AS INT64) AS id_product,
  CAST(ProductPrice AS NUMERIC) AS product_price,
  CAST(ProductName AS STRING) AS product_name,
  CAST(PictureFieName AS STRING) AS picture_file_name,
  CAST(BakeryOfferId AS INT64) AS id_offer,
  CAST(ProductCount AS INT64) AS product_count,
  CAST(IsAvailableInOffer AS BOOL) AS is_available_in_offer,
  CAST(IsAvailableInOfferSite AS BOOL) AS is_available_in_offer_site,
  CAST(ProductInOfferPrice AS NUMERIC) AS product_in_offer_price,
  CAST(VATForProductInOffer AS NUMERIC) AS vat_for_product_in_offer,
  CAST(Created AS TIMESTAMP) AS created_at,
  CAST(Updated AS TIMESTAMP) AS updated_at,
  CAST(UserId AS STRING) AS user_id
FROM ${ref("raw_catalog_OfferProduct")}
