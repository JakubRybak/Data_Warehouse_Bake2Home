config {
  type: "view",
  schema: "silver",
  description: "Cleaned and standardized offer product relationship data from catalog-db"
}

SELECT
  CAST(Id AS INT64) AS id_offer_product,
  CAST(ProductId AS INT64) AS id_product,
  COALESCE(CAST(ProductPrice AS NUMERIC), 0.0) AS product_price,
  COALESCE(CAST(ProductName AS STRING), 'Unknown') AS product_name,
  COALESCE(CAST(PictureFieName AS STRING), 'Unknown') AS picture_file_name,
  CAST(BakeryOfferId AS INT64) AS id_offer,
  COALESCE(CAST(ProductCount AS INT64), 0) AS product_count,
  COALESCE(CAST(IsAvailableInOffer AS BOOL), FALSE) AS is_available_in_offer,
  COALESCE(CAST(IsAvailableInOfferSite AS BOOL), FALSE) AS is_available_in_offer_site,
  COALESCE(CAST(ProductInOfferPrice AS NUMERIC), 0.0) AS product_in_offer_price,
  COALESCE(CAST(VATForProductInOffer AS NUMERIC), 0.0) AS vat_for_product_in_offer,
  CAST(Created AS TIMESTAMP) AS created_at,
  CAST(Updated AS TIMESTAMP) AS updated_at,
  COALESCE(CAST(UserId AS STRING), 'Unknown') AS user_id
FROM ${ref("raw_catalog_OfferProduct")}
