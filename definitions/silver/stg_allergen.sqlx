config {
  type: "view",
  schema: "silver",
  description: "Cleaned and standardized allergen data from catalog-db"
}

SELECT
  CAST(Id AS INT64) AS id_allergen,
  CAST(Name AS STRING) AS name,
  CAST(IsUsed AS BOOL) AS is_used,
  CAST(Created AS TIMESTAMP) AS created_at,
  CAST(Updated AS TIMESTAMP) AS updated_at,
  CAST(UserId AS STRING) AS user_id
FROM ${ref("raw_catalog_Allergen")}
