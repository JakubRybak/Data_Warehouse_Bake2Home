config {
  type: "view",
  schema: "silver",
  description: "Cleaned and standardized bought offer instances from planner-db, including conformed price cleaning and type mappings."
}

SELECT
  CAST(Id AS INT64) AS id_bought_offer_instance,
  CAST(OfferId AS INT64) AS id_offer,
  COALESCE(CAST(OfferName AS STRING), 'Unknown') AS offer_name,
  
  -- Natively stored as NUMERIC in postgres/parquet
  COALESCE(CAST(Price AS NUMERIC), 0.0) AS price,
  COALESCE(CAST(VAT AS NUMERIC), 0.0) AS vat,
  CAST(VatRateId AS INT64) AS vat_rate_id,
  
  -- Map C# OfferType enum to conformed bought_offer_instance_type
  COALESCE(CAST(Type AS INT64), 0) AS bought_offer_instance_type_id,
  CASE
    WHEN Type = 0 THEN 'SINGLE'
    WHEN Type = 1 THEN 'PROMOTION'
    ELSE 'UNKNOWN'
  END AS bought_offer_instance_type,
  
  COALESCE(CAST(PictureFileName AS STRING), 'Unknown') AS picture_file_name,
  COALESCE(CAST(UserId AS STRING), 'Unknown') AS user_id,
  CAST(Created AS TIMESTAMP) AS created_at,
  CAST(Updated AS TIMESTAMP) AS updated_at
FROM ${ref("raw_planner_BoughtOfferInstances")}
