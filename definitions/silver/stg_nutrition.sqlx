config {
  type: "view",
  schema: "silver",
  description: "Cleaned and standardized product nutritional data from catalog-db"
}

SELECT
  CAST(Id AS INT64) AS id_nutrition,
  CAST(ProductId AS INT64) AS id_product,
  COALESCE(CAST(Calories AS FLOAT64), 0.0) AS calories,
  COALESCE(CAST(TotalFats AS FLOAT64), 0.0) AS total_fats,
  COALESCE(CAST(SaturatedFats AS FLOAT64), 0.0) AS saturated_fats,
  COALESCE(CAST(TotalCarbohydrates AS FLOAT64), 0.0) AS total_carbohydrates,
  COALESCE(CAST(Sugar AS FLOAT64), 0.0) AS sugar,
  COALESCE(CAST(Protein AS FLOAT64), 0.0) AS protein,
  COALESCE(CAST(Sodium AS FLOAT64), 0.0) AS sodium,
  CAST(Created AS TIMESTAMP) AS created_at,
  CAST(Updated AS TIMESTAMP) AS updated_at,
  COALESCE(CAST(UserId AS STRING), 'Unknown') AS user_id
FROM ${ref("raw_catalog_Nutrition")}
