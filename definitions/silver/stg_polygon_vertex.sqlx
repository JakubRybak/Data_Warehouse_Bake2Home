config {
  type: "view",
  schema: "silver",
  description: "Cleaned and standardized polygon vertex data for locations from client-manager-db"
}

SELECT
  CAST(Id AS INT64) AS id_polygon_vertex,
  CAST(LocationId AS INT64) AS id_location,
  CAST(Latitude AS FLOAT64) AS latitude,
  CAST(Longitude AS FLOAT64) AS longitude,
  CAST(Created AS TIMESTAMP) AS created_at,
  CAST(Updated AS TIMESTAMP) AS updated_at,
  CAST(UserId AS STRING) AS user_id,
  CAST(ModifiedByUserId AS STRING) AS modified_by_user_id
FROM ${ref("raw_client_manager_PolygonVertex")}
