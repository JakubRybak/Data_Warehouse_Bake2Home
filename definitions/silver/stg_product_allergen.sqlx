config {
  type: "view",
  schema: "silver",
  description: "Cleaned and standardized product-allergen relationship data from catalog-db"
}

SELECT
  CAST(Id AS INT64) AS id_product_allergen,
  CAST(AllergenId AS INT64) AS id_allergen,
  CAST(BakeryProductId AS INT64) AS id_product,
  CAST(Created AS TIMESTAMP) AS created_at,
  CAST(Updated AS TIMESTAMP) AS updated_at,
  CAST(UserId AS STRING) AS user_id
FROM ${ref("raw_catalog_ProductAllergen")}
