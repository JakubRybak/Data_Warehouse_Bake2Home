config {
  type: "view",
  schema: "silver",
  description: "Cleaned and standardized business client data from client-manager-db"
}

SELECT
  CAST(Id AS INT64) AS id_client,
  COALESCE(CAST(Name AS STRING), 'Unknown') AS name,
  COALESCE(CAST(Description AS STRING), 'Unknown') AS description,
  COALESCE(CAST(NIP AS INT64), 0) AS nip,
  COALESCE(CAST(Street AS STRING), 'Unknown') AS street,
  COALESCE(CAST(City AS STRING), 'Unknown') AS city,
  COALESCE(CAST(Country AS STRING), 'Unknown') AS country,
  COALESCE(CAST(ZipCode AS STRING), 'Unknown') AS zip_code,
  COALESCE(CAST(PictureFileName AS STRING), 'Unknown') AS picture_file_name,
  CAST(Created AS TIMESTAMP) AS created_at,
  CAST(Updated AS TIMESTAMP) AS updated_at,
  COALESCE(CAST(UserId AS STRING), 'Unknown') AS user_id,
  COALESCE(CAST(ModifiedByUserId AS STRING), 'Unknown') AS modified_by_user_id,
  COALESCE(CAST(Email AS STRING), 'Unknown') AS email,
  COALESCE(CAST(FullFormalName AS STRING), 'Unknown') AS full_formal_name,
  COALESCE(CAST(Phone AS STRING), 'Unknown') AS phone,
  COALESCE(CAST(Story AS STRING), 'Unknown') AS story
FROM ${ref("raw_client_manager_Client")}
