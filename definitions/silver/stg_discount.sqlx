config {
  type: "view",
  schema: "silver",
  description: "Cleaned and standardized discount (voucher) data from wallet-db"
}

SELECT
  CAST(Id AS INT64) AS id_discount,
  
  -- Clean and cast financial/money columns that contain currency symbols in the raw parquet files
  COALESCE(SAFE_CAST(REGEXP_REPLACE(DiscountPercentage, r'[^\d.-]', '') AS NUMERIC), 0.0) AS discount_percentage,
  COALESCE(SAFE_CAST(REGEXP_REPLACE(DiscountFlatRate, r'[^\d.-]', '') AS NUMERIC), 0.0) AS discount_flat_rate,
  
  COALESCE(CAST(DiscountCode AS STRING), 'Unknown') AS discount_code,
  CAST(ActiveFrom AS TIMESTAMP) AS active_from,
  CAST(ActiveTo AS TIMESTAMP) AS active_to,
  COALESCE(CAST(UseLimitGlobally AS INT64), 0) AS use_limit_globally,
  COALESCE(CAST(UseLimitPerCustomer AS INT64), 0) AS use_limit_per_user,
  
  COALESCE(SAFE_CAST(REGEXP_REPLACE(MinimalTransactionAmount, r'[^\d.-]', '') AS NUMERIC), 0.0) AS minimal_transaction_amount,
  COALESCE(SAFE_CAST(REGEXP_REPLACE(MaximumTransactionAmount, r'[^\d.-]', '') AS NUMERIC), 0.0) AS maximum_transaction_amount,
  COALESCE(SAFE_CAST(REGEXP_REPLACE(MoneyLimitGlobally, r'[^\d.-]', '') AS NUMERIC), 0.0) AS money_limit_globally,
  COALESCE(SAFE_CAST(REGEXP_REPLACE(MoneyLimitPerCustomer, r'[^\d.-]', '') AS NUMERIC), 0.0) AS money_limit_per_user,
  
  COALESCE(CAST(OnlyForFirstPurchase AS BOOL), FALSE) AS only_for_first_purchase,
  CAST(ClientId AS INT64) AS id_client,
  CAST(CustomerId AS INT64) AS id_customer,
  COALESCE(CAST(LinkToTerms AS STRING), 'Unknown') AS link_to_terms,
  CAST(Created AS TIMESTAMP) AS created_at,
  CAST(Updated AS TIMESTAMP) AS updated_at
FROM ${ref("raw_wallet_Discounts")}
