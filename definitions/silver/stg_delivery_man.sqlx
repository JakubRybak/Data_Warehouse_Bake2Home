config {
  type: "view",
  schema: "silver",
  description: "Cleaned and standardized delivery courier data from delivery-account-manager-db"
}

SELECT
  CAST(Id AS INT64) AS id_delivery_man,
  COALESCE(CAST(Name AS STRING), 'Unknown') AS name,
  CAST(SiteId AS INT64) AS id_site,
  CAST(Created AS TIMESTAMP) AS created_at,
  CAST(Updated AS TIMESTAMP) AS updated_at
FROM ${ref("raw_delivery_account_manager_DeliveryMan")}
