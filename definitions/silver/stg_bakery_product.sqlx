config {
  type: "view",
  schema: "silver",
  description: "Cleaned and standardized bakery product data from catalog-db"
}

SELECT
  CAST(Id AS INT64) AS id_product,
  CAST(Name AS STRING) AS name,
  CAST(Description AS STRING) AS description,
  CAST(State AS INT64) AS state,
  CAST(PictureFileName AS STRING) AS picture_file_name,
  CAST(BakeryProductsTypeId AS INT64) AS id_product_type,
  CAST(PlatformClientId AS INT64) AS id_client,
  CAST(Weight AS FLOAT64) AS weight,
  CAST(Created AS TIMESTAMP) AS created_at,
  CAST(Updated AS TIMESTAMP) AS updated_at,
  CAST(UserId AS STRING) AS user_id,
  CAST(PreviousVersionProductId AS INT64) AS id_previous_version_product,
  CAST(ModifiedVersionProductId AS INT64) AS id_modified_version_product
FROM ${ref("raw_catalog_BakeryProduct")}
