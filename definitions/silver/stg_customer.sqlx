config {
  type: "view",
  schema: "silver",
  description: "Cleaned and standardized customer data from customer-manager-db"
}

SELECT
  CAST(Id AS INT64) AS id_customer,
  CAST(Name AS STRING) AS name,
  CAST(Email AS STRING) AS email,
  CAST(CustomerState AS INT64) AS customer_state,
  CAST(UserId AS STRING) AS user_id,
  CAST(PhoneNumber AS STRING) AS phone_number,
  CAST(Avatar AS STRING) AS avatar,
  CAST(OtherRoleStatus AS INT64) AS other_role_status,
  CAST(CustomerIp AS STRING) AS customer_ip,
  CAST(Created AS TIMESTAMP) AS created_at,
  CAST(Updated AS TIMESTAMP) AS updated_at
FROM ${ref("raw_customer_manager_Customer")}