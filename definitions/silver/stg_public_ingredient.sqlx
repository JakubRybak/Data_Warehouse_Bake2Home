config {
  type: "view",
  schema: "silver",
  description: "Cleaned and standardized public ingredient data from catalog-db"
}

SELECT
  CAST(Id AS INT64) AS id_ingredient,
  COALESCE(CAST(Name AS STRING), 'Unknown') AS name,
  COALESCE(CAST(Unit AS STRING), 'Unknown') AS unit,
  CAST(Created AS TIMESTAMP) AS created_at,
  CAST(Updated AS TIMESTAMP) AS updated_at,
  COALESCE(CAST(UserId AS STRING), 'Unknown') AS user_id
FROM ${ref("raw_catalog_PublicIngredient")}
