config {
  type: "view",
  schema: "silver",
  description: "Cleaned and standardized planner items from planner-db"
}

SELECT
  CAST(Id AS INT64) AS id_planner_item,
  COALESCE(CAST(PlannerItemState AS INT64), 0) AS planner_item_state_id,
  'TO BE SET' AS planner_item_state,
  COALESCE(CAST(Quantity AS INT64), 0) AS quantity,
  CAST(CustomerAddressId AS INT64) AS id_customer_address,
  COALESCE(CAST(DayIndex AS INT64), 0) AS day_index,
  CASE
    WHEN DayIndex = 0 THEN 'Sunday'
    WHEN DayIndex = 1 THEN 'Monday'
    WHEN DayIndex = 2 THEN 'Tuesday'
    WHEN DayIndex = 3 THEN 'Wednesday'
    WHEN DayIndex = 4 THEN 'Thursday'
    WHEN DayIndex = 5 THEN 'Friday'
    WHEN DayIndex = 6 THEN 'Saturday'
    ELSE 'Unknown'
  END AS day_name,
  COALESCE(CAST(NextVersion AS INT64), 0) AS next_version,
  COALESCE(CAST(PreviousVersion AS INT64), 0) AS previous_version,
  
  CAST(StartDate AS TIMESTAMP) AS start_date,
  CAST(EndDate AS TIMESTAMP) AS end_date,
  
  CAST(BoughtOfferInstanceId AS INT64) AS id_bought_offer_instance,
  COALESCE(CAST(UserId AS STRING), 'Unknown') AS user_id,
  CAST(ServicingBySiteId AS INT64) AS id_site,
  CAST(LocationId AS INT64) AS id_location,
  
  CAST(Created AS TIMESTAMP) AS created_at,
  CAST(Updated AS TIMESTAMP) AS updated_at
FROM ${ref("raw_planner_PlannerItems")}
