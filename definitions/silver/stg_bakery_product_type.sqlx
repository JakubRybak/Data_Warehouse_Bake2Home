config {
  type: "view",
  schema: "silver",
  description: "Cleaned and standardized bakery product types data from catalog-db"
}

SELECT
  CAST(Id AS INT64) AS id_product_type,
  CAST(Name AS STRING) AS name,
  CAST(PictureFileName AS STRING) AS picture_file_name,
  CAST(ProductTypeDisplayOrder AS INT64) AS product_type_display_order,
  CAST(Created AS TIMESTAMP) AS created_at,
  CAST(Updated AS TIMESTAMP) AS updated_at,
  CAST(UserId AS STRING) AS user_id
FROM ${ref("raw_catalog_BakeryProductsTypes")}
