config {
  type: "view",
  schema: "silver",
  description: "Cleaned and standardized bakery product types data from catalog-db"
}

SELECT
  CAST(Id AS INT64) AS id_product_type,
  COALESCE(CAST(Name AS STRING), 'Unknown') AS name,
  COALESCE(CAST(PictureFileName AS STRING), 'Unknown') AS picture_file_name,
  COALESCE(CAST(ProductTypeDisplayOrder AS INT64), 0) AS product_type_display_order,
  CAST(Created AS TIMESTAMP) AS created_at,
  CAST(Updated AS TIMESTAMP) AS updated_at,
  COALESCE(CAST(UserId AS STRING), 'Unknown') AS user_id
FROM ${ref("raw_catalog_BakeryProductsTypes")}
