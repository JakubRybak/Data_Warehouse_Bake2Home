config {
  type: "table",
  schema: "gold",
  description: "Payments fact table",
  bigquery: {
    partitionBy: "sk_date_payment_created",
    clusterBy: ["sk_customer", "sk_payment_method"]
  }
}

SELECT
  FARM_FINGERPRINT(COALESCE(CAST(p.id_payment AS STRING), "-999999")) AS sk_payment,
  COALESCE(p.id_payment, -999999) AS id_payment,
  COALESCE(p.id_order, -999999) AS id_order,
  COALESCE(p.id_delivery, -999999) AS id_delivery,
  COALESCE(p.id_discount, -999999) AS id_discount,
  COALESCE(o.id_site, d.id_site, -999999) AS id_site,
  COALESCE(pm.id_customer, -999999) AS id_customer,
  COALESCE(p.id_client, -999999) AS id_client,
  COALESCE(p.id_payment_method, -999999) AS id_payment_method,
  COALESCE(o.id_location, -999999) AS id_location,
  
  COALESCE(s.sk_site, active_s.sk_site, FARM_FINGERPRINT("-999999")) AS sk_site,
  COALESCE(disc.sk_discount, active_disc.sk_discount, FARM_FINGERPRINT("-999999")) AS sk_discount,
  COALESCE(pm_dim.sk_payment_method, FARM_FINGERPRINT("-999999")) AS sk_payment_method,
  COALESCE(c.sk_customer, active_c.sk_customer, FARM_FINGERPRINT("-999999")) AS sk_customer,
  
  COALESCE(CAST(p.created_at AS DATE), CAST("1970-01-01" AS DATE)) AS sk_date_payment_created,
  COALESCE(CAST(p.updated_at AS DATE), CAST("1970-01-01" AS DATE)) AS sk_date_payment_modified,
  COALESCE(l.sk_location, active_l.sk_location, FARM_FINGERPRINT("-999999")) AS sk_location,

  COALESCE(p.amount, 0.0) AS amount,
  COALESCE(p.discounted_amount, 0.0) AS discounted_amount,
  COALESCE(p.list_of_order_items, 'Unknown') AS list_of_order_items,
  COALESCE(p.error, 'Unknown') AS error,
  COALESCE(p.error IS NOT NULL AND p.error != '', FALSE) AS is_error,
  COALESCE(p.status_id, -999999) AS payment_state_id,
  COALESCE(p.status, 'Unknown') AS payment_state,
  COALESCE(p.payment_type_id, 0) AS payment_type_id,
  COALESCE(p.payment_type, 'Unknown') AS payment_type,
  COALESCE(p.for_manual_handling, FALSE) AS for_manual_handling

FROM ${ref("stg_payment")} p
LEFT JOIN ${ref("stg_bakery_orders")} o ON p.id_order = o.id_order AND p.id_order != 0
LEFT JOIN ${ref("stg_deliveries")} d ON p.id_delivery = d.id_delivery AND p.id_delivery != 0
LEFT JOIN ${ref("stg_payment_method")} pm ON p.id_payment_method = pm.id_payment_method AND p.id_payment_method != 0
LEFT JOIN ${ref("dim_site")} s ON COALESCE(o.id_site, d.id_site) = s.id_site AND COALESCE(o.id_site, d.id_site) != 0 AND p.created_at >= s.valid_from AND p.created_at < s.valid_to
LEFT JOIN ${ref("dim_site")} active_s ON COALESCE(o.id_site, d.id_site) = active_s.id_site AND COALESCE(o.id_site, d.id_site) != 0 AND active_s.is_current = TRUE
LEFT JOIN ${ref("dim_discount")} disc ON p.id_discount = disc.id_discount AND p.id_discount != 0 AND p.created_at >= disc.valid_from AND p.created_at < disc.valid_to
LEFT JOIN ${ref("dim_discount")} active_disc ON p.id_discount = active_disc.id_discount AND p.id_discount != 0 AND active_disc.is_current = TRUE
LEFT JOIN ${ref("dim_payment_method")} pm_dim ON p.id_payment_method = pm_dim.id_payment_method AND p.id_payment_method != 0
LEFT JOIN ${ref("dim_customer")} c ON pm.id_customer = c.id_customer AND pm.id_customer != 0 AND p.created_at >= c.valid_from AND p.created_at < c.valid_to
LEFT JOIN ${ref("dim_customer")} active_c ON pm.id_customer = active_c.id_customer AND pm.id_customer != 0 AND active_c.is_current = TRUE
LEFT JOIN ${ref("dim_location")} l ON COALESCE(o.id_location, -999999) = l.id_location AND COALESCE(o.id_location, -999999) != 0 AND p.created_at >= l.valid_from AND p.created_at < l.valid_to
LEFT JOIN ${ref("dim_location")} active_l ON COALESCE(o.id_location, -999999) = active_l.id_location AND COALESCE(o.id_location, -999999) != 0 AND active_l.is_current = TRUE
