config {
  type: "table",
  schema: "gold",
  description: "Bridge table linking Offers (dim_offer) and Products (dim_product) in a Many-to-Many relationship, using conformed surrogate and natural keys (SCD Type 1)."
}

SELECT
  -- Unique surrogate key for the relationship itself (very useful for BI counts)
  FARM_FINGERPRINT(CAST(id_offer_product AS STRING)) AS sk_offer_product,
  id_offer_product,
  id_offer,
  id_product,
  product_count,
  product_count AS product_in_offer_count
FROM ${ref("stg_offer_product")}
