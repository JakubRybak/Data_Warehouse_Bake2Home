config {
  type: "table",
  schema: "gold",
  description: "Date dimension table for the range 2024-2030",
  bigquery: {
    clusterBy: ["sk_date", "year", "month_number"]
  }
}

WITH date_series AS (
  SELECT date
  FROM UNNEST(GENERATE_DATE_ARRAY('2024-01-01', '2030-12-31')) AS date
),
base_calendar AS (
  SELECT
    date AS sk_date,
    EXTRACT(YEAR FROM date) AS year,
    EXTRACT(QUARTER FROM date) AS quarter,
    EXTRACT(WEEK FROM date) AS week,
    EXTRACT(MONTH FROM date) AS month_number,
    CASE EXTRACT(MONTH FROM date)
      WHEN 1 THEN 'January'
      WHEN 2 THEN 'February'
      WHEN 3 THEN 'March'
      WHEN 4 THEN 'April'
      WHEN 5 THEN 'May'
      WHEN 6 THEN 'June'
      WHEN 7 THEN 'July'
      WHEN 8 THEN 'August'
      WHEN 9 THEN 'September'
      WHEN 10 THEN 'October'
      WHEN 11 THEN 'November'
      WHEN 12 THEN 'December'
    END AS month_name,
    CASE EXTRACT(DAYOFWEEK FROM date)
      WHEN 1 THEN 7 -- Sunday
      WHEN 2 THEN 1 -- Monday
      WHEN 3 THEN 2 -- Tuesday
      WHEN 4 THEN 3 -- Wednesday
      WHEN 5 THEN 4 -- Thursday
      WHEN 6 THEN 5 -- Friday
      WHEN 7 THEN 6 -- Saturday
    END AS weekday_number,
    CASE EXTRACT(DAYOFWEEK FROM date)
      WHEN 1 THEN 'Sunday'
      WHEN 2 THEN 'Monday'
      WHEN 3 THEN 'Tuesday'
      WHEN 4 THEN 'Wednesday'
      WHEN 5 THEN 'Thursday'
      WHEN 6 THEN 'Friday'
      WHEN 7 THEN 'Saturday'
    END AS weekday_name
  FROM date_series
),
holidays AS (
  SELECT
    sk_date,
    IF(weekday_number IN (6, 7), TRUE, FALSE) AS is_weekend,
    CASE
      WHEN month_number = 1 AND EXTRACT(DAY FROM sk_date) = 1 THEN TRUE
      WHEN month_number = 1 AND EXTRACT(DAY FROM sk_date) = 6 THEN TRUE
      WHEN month_number = 5 AND EXTRACT(DAY FROM sk_date) = 1 THEN TRUE
      WHEN month_number = 5 AND EXTRACT(DAY FROM sk_date) = 3 THEN TRUE
      WHEN month_number = 8 AND EXTRACT(DAY FROM sk_date) = 15 THEN TRUE
      WHEN month_number = 11 AND EXTRACT(DAY FROM sk_date) = 1 THEN TRUE
      WHEN month_number = 11 AND EXTRACT(DAY FROM sk_date) = 11 THEN TRUE
      WHEN month_number = 12 AND EXTRACT(DAY FROM sk_date) = 24 THEN TRUE
      WHEN month_number = 12 AND EXTRACT(DAY FROM sk_date) = 25 THEN TRUE
      WHEN month_number = 12 AND EXTRACT(DAY FROM sk_date) = 26 THEN TRUE
      
      WHEN sk_date IN ('2024-03-31', '2024-04-01', '2024-05-19', '2024-05-30') THEN TRUE
      WHEN sk_date IN ('2025-04-20', '2025-04-21', '2025-06-08', '2025-06-19') THEN TRUE
      WHEN sk_date IN ('2026-04-05', '2026-04-06', '2026-05-24', '2026-06-04') THEN TRUE
      -- 2027
      WHEN sk_date IN ('2027-03-28', '2027-03-29', '2027-05-16', '2027-05-27') THEN TRUE
      -- 2028
      WHEN sk_date IN ('2028-04-16', '2028-04-17', '2028-06-04', '2028-06-15') THEN TRUE
      -- 2029
      WHEN sk_date IN ('2029-04-01', '2029-04-02', '2029-05-20', '2029-05-31') THEN TRUE
      -- 2030
      WHEN sk_date IN ('2030-04-21', '2030-04-22', '2030-06-09', '2030-06-20') THEN TRUE
      
      ELSE FALSE
    END AS is_holiday
  FROM base_calendar
)

SELECT
  c.sk_date,
  c.year,
  c.quarter,
  c.week,
  c.month_number,
  c.month_name,
  c.weekday_number,
  c.weekday_name,
  h.is_weekend,
  h.is_holiday,
  IF(h.is_weekend = FALSE AND h.is_holiday = FALSE, TRUE, FALSE) AS is_working
FROM base_calendar c
JOIN holidays h ON c.sk_date = h.sk_date

UNION ALL

SELECT
  CAST('1970-01-01' AS DATE) AS sk_date,
  1970 AS year,
  1 AS quarter,
  1 AS week,
  1 AS month_number,
  'January' AS month_name,
  1 AS weekday_number,
  'Monday' AS weekday_name,
  FALSE AS is_weekend,
  FALSE AS is_holiday,
  TRUE AS is_working
