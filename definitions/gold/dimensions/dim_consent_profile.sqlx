config {
  type: "table",
  schema: "gold",
  description: "Junk dimension storing all possible combinations of customer consent states (RODO, Terms, Marketing). Stored values correspond directly to backend ConsentStatus enum: ACTIVE, CANCELLED, EXPIRED, NO_CONSENT. Includes a conformed Unknown row."
}

WITH states AS (
  SELECT 1 AS state_id, 'ACTIVE' AS state
  UNION ALL
  SELECT 2 AS state_id, 'CANCELLED' AS state
  UNION ALL
  SELECT 3 AS state_id, 'EXPIRED' AS state
  UNION ALL
  SELECT 0 AS state_id, 'NO_CONSENT' AS state
)

SELECT
  FARM_FINGERPRINT("-999999") AS sk_consent_profile,
  0 AS rodo_state_id,
  'Unknown' AS rodo_state,
  0 AS terms_state_id,
  'Unknown' AS terms_state,
  0 AS marketing_state_id,
  'Unknown' AS marketing_state

UNION ALL

SELECT
  -- Generate unique INT64 surrogate key using FARM_FINGERPRINT on combined states
  FARM_FINGERPRINT(CONCAT(r.state, '|', t.state, '|', m.state)) AS sk_consent_profile,
  r.state_id AS rodo_state_id,
  r.state AS rodo_state,
  t.state_id AS terms_state_id,
  t.state AS terms_state,
  m.state_id AS marketing_state_id,
  m.state AS marketing_state
FROM states r
CROSS JOIN states t
CROSS JOIN states m
