config {
  type: "table",
  schema: "gold",
  description: "Customer delivery addresses dimension table",
  bigquery: {
    clusterBy: ["id_customer", "id_customer_address"]
  }
}

WITH competitor_metrics AS (
  SELECT
    a.id_customer_address,
    
    COALESCE(MIN(IF(c.competitor_type = 'bakery', ST_DISTANCE(a.geo_point, c.geo_point), NULL)), -1.0) AS dist_to_nearest_comp_bakery_m,
    COALESCE(MIN(IF(c.competitor_type = 'supermarket', ST_DISTANCE(a.geo_point, c.geo_point), NULL)), -1.0) AS dist_to_nearest_comp_supermarket_m,
    
    COUNTIF(c.competitor_type = 'bakery' AND ST_DISTANCE(a.geo_point, c.geo_point) <= 300.0) AS comp_bakery_count_300m,
    COUNTIF(c.competitor_type = 'bakery' AND ST_DISTANCE(a.geo_point, c.geo_point) <= 500.0) AS comp_bakery_count_500m,
    COUNTIF(c.competitor_type = 'bakery' AND ST_DISTANCE(a.geo_point, c.geo_point) <= 1000.0) AS comp_bakery_count_1000m,
    COUNTIF(c.competitor_type = 'bakery' AND ST_DISTANCE(a.geo_point, c.geo_point) <= 2000.0) AS comp_bakery_count_2000m,
    
    COUNTIF(c.competitor_type = 'supermarket' AND ST_DISTANCE(a.geo_point, c.geo_point) <= 500.0) AS comp_supermarket_count_500m,
    COUNTIF(c.competitor_type = 'supermarket' AND ST_DISTANCE(a.geo_point, c.geo_point) <= 1000.0) AS comp_supermarket_count_1000m,
    COUNTIF(c.competitor_type = 'supermarket' AND ST_DISTANCE(a.geo_point, c.geo_point) <= 2000.0) AS comp_supermarket_count_2000m,
    COUNTIF(c.competitor_type = 'supermarket' AND ST_DISTANCE(a.geo_point, c.geo_point) <= 3000.0) AS comp_supermarket_count_3000m
  FROM ${ref("stg_customer_address")} a
  LEFT JOIN ${ref("dim_competitor")} c
    ON ST_DISTANCE(a.geo_point, c.geo_point) <= 3000.0
  GROUP BY a.id_customer_address
),

own_site_metrics AS (
  SELECT
    a.id_customer_address,
    COALESCE(MIN(ST_DISTANCE(a.geo_point, s.geo_point)), -1.0) AS dist_to_nearest_own_site_m,
    COUNTIF(ST_DISTANCE(a.geo_point, s.geo_point) <= 300.0) AS own_site_count_300m,
    COUNTIF(ST_DISTANCE(a.geo_point, s.geo_point) <= 500.0) AS own_site_count_500m,
    COUNTIF(ST_DISTANCE(a.geo_point, s.geo_point) <= 1000.0) AS own_site_count_1000m,
    COUNTIF(ST_DISTANCE(a.geo_point, s.geo_point) <= 2000.0) AS own_site_count_2000m,
    COUNTIF(ST_DISTANCE(a.geo_point, s.geo_point) <= 3000.0) AS own_site_count_3000m
  FROM ${ref("stg_customer_address")} a
  LEFT JOIN ${ref("dim_site")} s
    ON s.id_site != -999999
    AND s.is_current = TRUE
    AND ST_DISTANCE(a.geo_point, s.geo_point) <= 3000.0
  GROUP BY a.id_customer_address
)

SELECT
  FARM_FINGERPRINT("-999999") AS sk_customer_address,
  -999999 AS id_customer_address,
  -999999 AS id_customer,
  'Unknown' AS address_name,
  'Unknown' AS address,
  0.0 AS longitude,
  0.0 AS latitude,
  ST_GEOGPOINT(0.0, 0.0) AS geo_point,
  'Unknown' AS additional_information,
  -1.0 AS dist_to_nearest_own_site_m,
  -1.0 AS dist_to_nearest_comp_bakery_m,
  -1.0 AS dist_to_nearest_comp_supermarket_m,
  0 AS comp_bakery_count_300m,
  0 AS comp_bakery_count_500m,
  0 AS comp_bakery_count_1000m,
  0 AS comp_bakery_count_2000m,
  0 AS comp_supermarket_count_500m,
  0 AS comp_supermarket_count_1000m,
  0 AS comp_supermarket_count_2000m,
  0 AS comp_supermarket_count_3000m,
  0 AS own_site_count_300m,
  0 AS own_site_count_500m,
  0 AS own_site_count_1000m,
  0 AS own_site_count_2000m,
  0 AS own_site_count_3000m,
  0 AS state_id,
  'Unknown' AS state

UNION ALL

SELECT
  FARM_FINGERPRINT(CAST(a.id_customer_address AS STRING)) AS sk_customer_address,
  a.id_customer_address,
  a.id_customer,
  a.address_name,
  a.address,
  a.longitude,
  a.latitude,
  a.geo_point,
  'None' AS additional_information,
  osm.dist_to_nearest_own_site_m,
  cm.dist_to_nearest_comp_bakery_m,
  cm.dist_to_nearest_comp_supermarket_m,
  COALESCE(cm.comp_bakery_count_300m, 0) AS comp_bakery_count_300m,
  COALESCE(cm.comp_bakery_count_500m, 0) AS comp_bakery_count_500m,
  COALESCE(cm.comp_bakery_count_1000m, 0) AS comp_bakery_count_1000m,
  COALESCE(cm.comp_bakery_count_2000m, 0) AS comp_bakery_count_2000m,
  COALESCE(cm.comp_supermarket_count_500m, 0) AS comp_supermarket_count_500m,
  COALESCE(cm.comp_supermarket_count_1000m, 0) AS comp_supermarket_count_1000m,
  COALESCE(cm.comp_supermarket_count_2000m, 0) AS comp_supermarket_count_2000m,
  COALESCE(cm.comp_supermarket_count_3000m, 0) AS comp_supermarket_count_3000m,
  COALESCE(osm.own_site_count_300m, 0) AS own_site_count_300m,
  COALESCE(osm.own_site_count_500m, 0) AS own_site_count_500m,
  COALESCE(osm.own_site_count_1000m, 0) AS own_site_count_1000m,
  COALESCE(osm.own_site_count_2000m, 0) AS own_site_count_2000m,
  COALESCE(osm.own_site_count_3000m, 0) AS own_site_count_3000m,
  a.state AS state_id,
  CASE
    WHEN a.state = 0 THEN 'CURRENT'
    WHEN a.state = 1 THEN 'PREVIOUS'
    WHEN a.state = 2 THEN 'OTHER'
    ELSE 'UNKNOWN'
  END AS state
FROM ${ref("stg_customer_address")} a
LEFT JOIN competitor_metrics cm ON a.id_customer_address = cm.id_customer_address AND a.id_customer_address != 0
LEFT JOIN own_site_metrics osm ON a.id_customer_address = osm.id_customer_address AND a.id_customer_address != 0
