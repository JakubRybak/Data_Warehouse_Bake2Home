config {
  type: "table",
  schema: "gold",
  description: "Payment methods dimension table, including mapped types, currencies, card brands, mobile flags, and status details (SCD Type 1). Includes a conformed Unknown row."
}

SELECT
  FARM_FINGERPRINT("-999999") AS sk_payment_method,
  -999999 AS id_payment_method,
  0 AS type_id,
  'Unknown' AS type,
  'Unknown' AS currency,
  'Unknown' AS card_brand,
  FALSE AS mobile,
  0 AS state_id,
  'Unknown' AS state

UNION ALL

SELECT
  -- Generate unique conformed surrogate key based on natural primary key (SCD Type 1)
  FARM_FINGERPRINT(CAST(id_payment_method AS STRING)) AS sk_payment_method,
  id_payment_method,
  
  -- Map C# PaymentMethodType enum (0 = CardToken, 1 = PayByLink, shifted by 1 in the database)
  type AS type_id,
  CASE
    WHEN type = 1 THEN 'CARD_TOKEN'
    WHEN type = 2 THEN 'PAY_BY_LINK'
    ELSE 'UNKNOWN'
  END AS type,
  
  currency,
  card_brand,
  mobile,
  
  -- Map C# PaymentMethodState enum
  status AS state_id,
  CASE
    WHEN status = 0 THEN 'PRIMARY'
    WHEN status = 1 THEN 'ACTIVE'
    WHEN status = 2 THEN 'EXPIRED'
    WHEN status = 3 THEN 'ENABLED'
    WHEN status = 4 THEN 'DISABLED'
    WHEN status = 5 THEN 'TEMPORARY_DISABLED'
    WHEN status = 6 THEN 'WAITING_FOR_3DS2'
    WHEN status = 7 THEN 'WAITING_FOR_CVV'
    WHEN status = 8 THEN 'REJECTED'
    ELSE 'UNKNOWN'
  END AS state
FROM ${ref("stg_payment_method")}
