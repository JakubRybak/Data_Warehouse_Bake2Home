config {
  type: "incremental",
  schema: "gold",
  description: "Locations (delivery zones) dimension table",
  bigquery: {
    clusterBy: ["id_location", "is_current"]
  }
}

pre_operations {
  ${when(incremental(), `
    MERGE ${self()} T
    USING (
      WITH aggregated_vertices AS (
        SELECT
          id_location,
          TO_JSON_STRING(
            ARRAY_AGG(
              STRUCT(latitude, longitude)
              ORDER BY id_polygon_vertex
            )
          ) AS vertexes
        FROM ${ref("stg_polygon_vertex")}
        GROUP BY id_location
      )
      SELECT
        l.id_location,
        l.name,
        l.description,
        l.state AS state_id,
        CASE
          WHEN l.state = 0 THEN 'EXISTING'
          WHEN l.state = 1 THEN 'DELETED'
          ELSE 'UNKNOWN'
        END AS state,
        COALESCE(v.vertexes, '[]') AS vertexes,
        l.created_at,
        l.updated_at
      FROM ${ref("stg_location")} l
      LEFT JOIN aggregated_vertices v ON l.id_location = v.id_location
    ) S
    ON T.id_location = S.id_location AND T.is_current = TRUE
    WHEN MATCHED AND (
      T.name IS DISTINCT FROM S.name OR
      T.description IS DISTINCT FROM S.description OR
      T.state_id IS DISTINCT FROM S.state_id OR
      T.state IS DISTINCT FROM S.state OR
      T.vertexes IS DISTINCT FROM S.vertexes
    ) THEN
      UPDATE SET 
        T.valid_to = COALESCE(S.updated_at, S.created_at, CURRENT_TIMESTAMP()),
        T.is_current = FALSE
  `)}
}

WITH aggregated_vertices AS (
  SELECT
    id_location,
    TO_JSON_STRING(
      ARRAY_AGG(
        STRUCT(latitude, longitude)
        ORDER BY id_polygon_vertex
      )
    ) AS vertexes
  FROM ${ref("stg_polygon_vertex")}
  GROUP BY id_location
)

SELECT
  FARM_FINGERPRINT("-999999") AS sk_location,
  -999999 AS id_location,
  'Unknown' AS name,
  'Unknown' AS description,
  0 AS state_id,
  'Unknown' AS state,
  '[]' AS vertexes,
  TIMESTAMP("1970-01-01 00:00:00") AS valid_from,
  TIMESTAMP("9999-12-31 23:59:59") AS valid_to,
  TRUE AS is_current
${when(incremental(), `WHERE FALSE`)}

UNION ALL

SELECT
  FARM_FINGERPRINT(
    CONCAT(
      CAST(l.id_location AS STRING), '|',
      CAST(
        ${when(incremental(), 
          `COALESCE(l.updated_at, l.created_at, CURRENT_TIMESTAMP())`, 
          `COALESCE(l.created_at, CURRENT_TIMESTAMP())`
        )} AS STRING
      )
    )
  ) AS sk_location,
  l.id_location,
  l.name,
  l.description,
  l.state AS state_id,
  CASE
    WHEN l.state = 0 THEN 'EXISTING'
    WHEN l.state = 1 THEN 'DELETED'
    ELSE 'UNKNOWN'
  END AS state,
  COALESCE(v.vertexes, '[]') AS vertexes,
  ${when(incremental(), 
    `COALESCE(l.updated_at, l.created_at, CURRENT_TIMESTAMP())`, 
    `COALESCE(l.created_at, CURRENT_TIMESTAMP())`
  )} AS valid_from,
  TIMESTAMP("9999-12-31 23:59:59") AS valid_to,
  TRUE AS is_current
FROM ${ref("stg_location")} l
LEFT JOIN aggregated_vertices v ON l.id_location = v.id_location
${when(incremental(), `
  WHERE NOT EXISTS (
    SELECT 1 FROM ${self()} t
    WHERE t.id_location = l.id_location AND t.is_current = TRUE
  )
`)}
