config {
  type: "incremental",
  schema: "gold",
  description: "Customer dimension table",
  bigquery: {
    clusterBy: ["id_customer", "is_current"]
  }
}

pre_operations {
  ${when(incremental(), `
    MERGE ${self()} T
    USING (
      WITH latest_consents AS (
        SELECT
          id_customer,
          id_consent,
          state,
          ROW_NUMBER() OVER(PARTITION BY id_customer, id_consent ORDER BY consent_date DESC) as rn
        FROM ${ref("stg_customer_consent")}
      ),
      pivoted_consents AS (
        SELECT
          id_customer,
          COALESCE(MAX(CASE WHEN id_consent = -1 THEN state END), 0) AS rodo_state_id,
          COALESCE(MAX(CASE WHEN id_consent = -2 THEN state END), 0) AS terms_state_id,
          COALESCE(MAX(CASE WHEN id_consent = -3 THEN state END), 0) AS marketing_state_id
        FROM latest_consents
        WHERE rn = 1
        GROUP BY id_customer
      )
      SELECT
        c.id_customer,
        c.name,
        c.customer_state AS customer_state_id,
        CASE 
          WHEN c.customer_state = 0 THEN 'NEW'
          WHEN c.customer_state = 1 THEN 'ACTIVE'
          WHEN c.customer_state = 2 THEN 'SUSPENDED'
          WHEN c.customer_state = 3 THEN 'CLOSED'
          ELSE 'UNKNOWN'
        END AS customer_state,
        cp.sk_consent_profile,
        c.created_at AS account_created_at,
        c.updated_at
      FROM ${ref("stg_customer")} c
      LEFT JOIN pivoted_consents pc ON c.id_customer = pc.id_customer
      LEFT JOIN ${ref("dim_consent_profile")} cp ON
        COALESCE(pc.rodo_state_id, 0) = cp.rodo_state_id AND
        COALESCE(pc.terms_state_id, 0) = cp.terms_state_id AND
        COALESCE(pc.marketing_state_id, 0) = cp.marketing_state_id
    ) S
    ON T.id_customer = S.id_customer AND T.is_current = TRUE
    WHEN MATCHED AND (
      T.name IS DISTINCT FROM S.name OR
      T.customer_state_id IS DISTINCT FROM S.customer_state_id OR
      T.sk_consent_profile IS DISTINCT FROM S.sk_consent_profile
    ) THEN
      UPDATE SET 
        T.valid_to = COALESCE(S.updated_at, CURRENT_TIMESTAMP()),
        T.is_current = FALSE
  `)}
}

WITH latest_consents AS (
  SELECT
    id_customer,
    id_consent,
    state,
    ROW_NUMBER() OVER(PARTITION BY id_customer, id_consent ORDER BY consent_date DESC) as rn
  FROM ${ref("stg_customer_consent")}
),
pivoted_consents AS (
  SELECT
    id_customer,
    COALESCE(MAX(CASE WHEN id_consent = -1 THEN state END), 0) AS rodo_state_id,
    COALESCE(MAX(CASE WHEN id_consent = -2 THEN state END), 0) AS terms_state_id,
    COALESCE(MAX(CASE WHEN id_consent = -3 THEN state END), 0) AS marketing_state_id
  FROM latest_consents
  WHERE rn = 1
  GROUP BY id_customer
),
source_data AS (
  SELECT
    c.id_customer,
    cp.sk_consent_profile,
    c.name,
    c.customer_state AS customer_state_id,
    CASE 
      WHEN c.customer_state = 0 THEN 'NEW'
      WHEN c.customer_state = 1 THEN 'ACTIVE'
      WHEN c.customer_state = 2 THEN 'SUSPENDED'
      WHEN c.customer_state = 3 THEN 'CLOSED'
      ELSE 'UNKNOWN'
    END AS customer_state,
    c.created_at,
    c.updated_at
  FROM ${ref("stg_customer")} c
  LEFT JOIN pivoted_consents pc ON c.id_customer = pc.id_customer
  LEFT JOIN ${ref("dim_consent_profile")} cp ON
    COALESCE(pc.rodo_state_id, 0) = cp.rodo_state_id AND
    COALESCE(pc.terms_state_id, 0) = cp.terms_state_id AND
    COALESCE(pc.marketing_state_id, 0) = cp.marketing_state_id
)

SELECT
  FARM_FINGERPRINT("-999999") AS sk_customer,
  -999999 AS id_customer,
  FARM_FINGERPRINT("-999999") AS sk_consent_profile,
  'Unknown' AS name,
  0 AS customer_state_id,
  'Unknown' AS customer_state,
  TIMESTAMP("1970-01-01 00:00:00") AS account_created_at,
  TIMESTAMP("1970-01-01 00:00:00") AS valid_from,
  TIMESTAMP("9999-12-31 23:59:59") AS valid_to,
  TRUE AS is_current
${when(incremental(), `WHERE FALSE`)}

UNION ALL

SELECT
  FARM_FINGERPRINT(
    CONCAT(
      CAST(id_customer AS STRING), '|',
      CAST(
        ${when(incremental(), 
          `COALESCE(updated_at, created_at, CURRENT_TIMESTAMP())`, 
          `COALESCE(created_at, CURRENT_TIMESTAMP())`
        )} AS STRING
      )
    )
  ) AS sk_customer,
  id_customer,
  sk_consent_profile,
  name,
  customer_state_id,
  customer_state,
  COALESCE(created_at, TIMESTAMP("1970-01-01 00:00:00")) AS account_created_at,
  ${when(incremental(), 
    `COALESCE(updated_at, created_at, CURRENT_TIMESTAMP())`, 
    `COALESCE(created_at, CURRENT_TIMESTAMP())`
  )} AS valid_from,
  TIMESTAMP("9999-12-31 23:59:59") AS valid_to,
  TRUE AS is_current
FROM source_data s
${when(incremental(), `
  WHERE NOT EXISTS (
    SELECT 1 FROM ${self()} t
    WHERE t.id_customer = s.id_customer AND t.is_current = TRUE
  )
`)}
