config {
  type: "view",
  schema: "gold",
  description: "Zdenormalizowany widok analityczny pozycji zamówień (fact_order_item) złączony ze wszystkimi wymiarami, w tym z zagregowanymi produktami i alergenami. Zaprojektowany jako Single Source of Truth dla Looker Studio."
}

WITH offer_products_agg AS (
  SELECT
    bop.id_offer,
    -- Agregacja nazw produktów w ofercie z ich krotnością
    COALESCE(
      STRING_AGG(CONCAT(p.name, ' (x', CAST(bop.product_count AS STRING), ')'), ', ' ORDER BY p.name),
      'Unknown'
    ) AS products_list,
    -- Agregacja unikalnych kategorii/typów produktów w ofercie
    COALESCE(
      STRING_AGG(DISTINCT p.product_type_name, ', ' ORDER BY p.product_type_name),
      'Unknown'
    ) AS product_types_list,
    -- Agregacja unikalnych alergenów dla wszystkich produktów w danej ofercie
    COALESCE(
      STRING_AGG(DISTINCT al.name, ', ' ORDER BY al.name),
      'None'
    ) AS allergens_list
  FROM ${ref("bridge_offer_product")} bop
  JOIN ${ref("dim_product")} p 
    ON bop.id_product = p.id_product 
    AND p.is_current = TRUE
  LEFT JOIN ${ref("bridge_product_allergen")} bpa 
    ON p.id_product = bpa.id_product
  LEFT JOIN ${ref("dim_allergen")} al 
    ON bpa.id_allergen = al.id_allergen
  GROUP BY bop.id_offer
)

SELECT
  -- 1. Identyfikatory i Klucze Naturalne (Degenerate Dimensions)
  f.id_order_item,
  f.id_order,
  f.id_bought_offer_instance,
  f.id_customer,
  f.id_offer,
  f.id_site,
  f.id_location,
  f.id_customer_address,

  -- 2. Wymiar Czasu (Order Date)
  f.sk_date_order AS order_date,
  d.year AS order_year,
  d.quarter AS order_quarter,
  d.month_number AS order_month_number,
  d.month_name AS order_month_name,
  d.weekday_number AS order_weekday_number,
  d.weekday_name AS order_weekday_name,
  d.is_weekend AS is_order_on_weekend,
  d.is_holiday AS is_order_on_holiday,
  d.is_working AS is_order_on_working_day,
  f.created_at AS order_created_timestamp,

  -- 3. Wymiar Oferty i Produktów (Offer & Products Details)
  COALESCE(o.name, 'Unknown') AS offer_name,
  COALESCE(o.type, 'Unknown') AS offer_type,
  COALESCE(o.state, 'Unknown') AS offer_state,
  COALESCE(opa.products_list, 'No Products') AS products_in_offer,
  COALESCE(opa.product_types_list, 'No Categories') AS product_categories_in_offer,
  COALESCE(opa.allergens_list, 'None') AS allergens_in_offer,

  -- 4. Wymiar Klienta (Customer Details)
  COALESCE(c.name, 'Unknown') AS customer_name,
  COALESCE(c.customer_state, 'Unknown') AS customer_state,

  -- 5. Wymiar Adresu Dostawy (Delivery Address Details)
  COALESCE(ca.address_name, 'Unknown') AS address_name,
  COALESCE(ca.address, 'Unknown') AS delivery_address,
  COALESCE(ca.state, 'Unknown') AS address_state,

  -- 6. Wymiar Lokalizacji i Piekarni (Location & Site Details)
  COALESCE(l.name, 'Unknown') AS location_name,
  COALESCE(l.city, 'Unknown') AS location_city,
  COALESCE(l.country, 'Unknown') AS location_country,
  COALESCE(s.name, 'Unknown') AS bakery_site_name,
  COALESCE(s.city, 'Unknown') AS bakery_site_city,

  -- 7. Statusy i Stany Biznesowe (Conformed Enum States)
  f.bought_offer_instance_type,
  f.order_item_state,
  f.order_state,
  f.modified_by_hand AS is_modified_by_hand,

  -- 8. Wskaźniki Finansowe i Mierniki (Metrics)
  f.quantity,
  f.price AS gross_unit_price,
  f.vat AS vat_rate,
  
  -- Kwota brutto (gross amount) = cena * ilość
  ROUND(f.price * f.quantity, 2) AS gross_amount,
  
  -- Kwota netto (net amount) = brutto / (1 + vat)
  ROUND((f.price * f.quantity) / (1.0 + f.vat), 2) AS net_amount,
  
  -- Kwota VAT (vat amount) = brutto - netto
  ROUND((f.price * f.quantity) - ((f.price * f.quantity) / (1.0 + f.vat)), 2) AS vat_amount

FROM ${ref("fact_order_item")} f
LEFT JOIN ${ref("dim_date")} d 
  ON f.sk_date_order = d.sk_date
LEFT JOIN ${ref("dim_offer")} o 
  ON f.sk_offer = o.sk_offer
LEFT JOIN ${ref("dim_customer")} c 
  ON f.sk_customer = c.sk_customer
LEFT JOIN ${ref("dim_customer_address")} ca 
  ON f.sk_customer_address = ca.sk_customer_address
LEFT JOIN ${ref("dim_location")} l 
  ON f.sk_location = l.sk_location
LEFT JOIN ${ref("dim_site")} s 
  ON f.sk_site = s.sk_site
LEFT JOIN offer_products_agg opa 
  ON f.id_offer = opa.id_offer
