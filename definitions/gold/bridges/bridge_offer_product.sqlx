config {
  type: "table",
  schema: "gold",
  description: "Bridge table linking Offers (dim_offer) and Products (dim_product)"
}

SELECT
  FARM_FINGERPRINT(CAST(id_offer_product AS STRING)) AS sk_offer_product,
  id_offer_product,
  id_offer,
  id_product,
  product_count,
  product_count AS product_in_offer_count
FROM ${ref("stg_offer_product")}
