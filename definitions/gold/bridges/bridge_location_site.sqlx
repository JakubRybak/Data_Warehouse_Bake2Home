config {
  type: "table",
  schema: "gold",
  description: "Bridge table linking Sites/Bakeries (dim_site) and Locations/Delivery zones (dim_location)",
  bigquery: {
    clusterBy: ["id_location", "id_site"]
  }
}

SELECT
  FARM_FINGERPRINT(CAST(id_location_site AS STRING)) AS sk_location_site,
  id_location_site,
  id_location,
  id_site
FROM ${ref("stg_location_site")}
