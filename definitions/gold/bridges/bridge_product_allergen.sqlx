config {
  type: "table",
  schema: "gold",
  description: "Bridge table linking Products (dim_product) and Allergens (dim_allergen)",
  bigquery: {
    clusterBy: ["id_product", "id_allergen"]
  }
}

SELECT
  FARM_FINGERPRINT(CAST(id_product_allergen AS STRING)) AS sk_product_allergen,
  id_product_allergen,
  id_product,
  id_allergen
FROM ${ref("stg_product_allergen")}
