config {
  type: "table",
  schema: "gold",
  description: "Customer delivery addresses dimension table, storing geo-coordinates, BigQuery spatial geography points, and customer associations. Includes a conformed Unknown row."
}

SELECT
  FARM_FINGERPRINT("-999999") AS sk_customer_address,
  -999999 AS id_customer_address,
  -999999 AS id_customer,
  'Unknown' AS address_name,
  'Unknown' AS address,
  0.0 AS longitude,
  0.0 AS latitude,
  ST_GEOGPOINT(0.0, 0.0) AS geo_point,
  0 AS state_id,
  'Unknown' AS state

UNION ALL

SELECT
  -- Generate unique INT64 surrogate key using FARM_FINGERPRINT on the natural primary key
  FARM_FINGERPRINT(CAST(id_customer_address AS STRING)) AS sk_customer_address,
  id_customer_address,
  id_customer,
  address_name,
  address,
  longitude,
  latitude,
  geo_point,
  state AS state_id,
  CASE
    WHEN state = 0 THEN 'CURRENT'
    WHEN state = 1 THEN 'PREVIOUS'
    WHEN state = 2 THEN 'OTHER'
    ELSE 'UNKNOWN'
  END AS state
FROM ${ref("stg_customer_address")}
